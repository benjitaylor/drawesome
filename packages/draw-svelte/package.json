{
  "name": "draw-svelte",
  "version": "0.1.0",
  "description": "A drawing toolbar for Svelte. Seven pens, an eraser, SVG and PNG export, no dependencies.",
  "keywords": [
    "svelte",
    "drawing",
    "canvas",
    "svg",
    "freehand",
    "annotation",
    "whiteboard",
    "sketch",
    "markup",
    "toolbar"
  ],
  "license": "MIT",
  "author": "Benji Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjitaylor/drawesome.git"
  },
  "homepage": "https://benji.org/drawesome",
  "bugs": {
    "url": "https://github.com/benjitaylor/drawesome/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/components/tokens.css"
  },
  "files": [
    "dist",
    "logo.svg",
    "logo-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "svelte-package",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": ">=5.20.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  }
}
